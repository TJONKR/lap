# Copy to .env (or set on your host). Never commit real values.

PORT=8787
DATABASE_PATH=./data/affiliate.sqlite
# Public URL creators see in their link / stats URL.
PUBLIC_ORIGIN=https://creators.lap.run

# Long random string. Sent as `Authorization: Bearer <token>` to /admin/*.
ADMIN_TOKEN=

# Exactly what you paste into RevenueCat → Integrations → Webhooks → "Authorization header".
# Any string works; include the "Bearer " prefix if you use one there.
REVENUECAT_WEBHOOK_AUTH=

# App Store page. Campaign token `ct=<code>` and provider token `pt=` are appended per creator.
APP_STORE_URL=https://apps.apple.com/app/lap/id0000000000
# App Store Connect → App Analytics → Campaigns → provider token (pt). Optional.
APP_STORE_PROVIDER_TOKEN=

# Economics
COMMISSION_SHARE=0.5          # creator share of net proceeds
ATTRIBUTION_WINDOW_MONTHS=12  # months after first paid tx that renewals still earn
HOLD_DAYS=30                  # refund window before a commission is payable
MIN_PAYOUT_CENTS=2000         # $20
DEFAULT_TAKEHOME=0.85         # Small Business Program; used when RevenueCat omits takehome_percentage

# 1 = new creators wait in `pending` until approved in /admin
REQUIRE_APPROVAL=0
# 1 = sandbox purchases earn (test) commission — only while testing
INCLUDE_SANDBOX=0
